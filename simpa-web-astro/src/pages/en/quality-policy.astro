---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getPageSection } from '../../lib/queries.js';
import { env } from 'cloudflare:workers';

const lang = 'en';
const kalitePolitikasi = await getPageSection(env.DB, 'Simpa', 'hakkimizda', 'kalite_politikasi', lang);
---
<Layout title="Quality Policy — Simpa Elektrik" lang={lang}>
  <div class="desktop-only">
    <div class="bc"><div class="bc-in"><a href="/en">Home</a><span>›</span><span class="cur">Our Quality Policy</span></div></div>
  </div>
  <div class="mobile-only">
    <div class="m-bc"><a href="/en">Home</a><span>›</span><span style="color:var(--g800)">Our Quality Policy</span></div>
  </div>

  <div class="sec"><div class="sec-in" style="max-width:960px">
    <h1 style="font-family:var(--cond);font-size:28px;color:var(--navy);margin-bottom:20px">Our Quality Policy</h1>
    <div class="kalite-layout">
      <div class="kalite-text" set:html={kalitePolitikasi} />
      <figure class="kalite-img">
        <img src="https://assets.superpress.com.tr/TSEK-001.jpg" alt="TSEK Certificate" loading="lazy" />
      </figure>
    </div>
  </div></div>
</Layout>

<style>
  .kalite-layout { display: grid; grid-template-columns: 1fr 260px; gap: 32px; align-items: start; }
  :global(.kalite-text p) { font-size: 14.5px; color: var(--g600); line-height: 1.85; margin-bottom: 4px; }
  :global(.kalite-text ul) { list-style: none; padding: 0; margin: 16px 0; display: flex; flex-direction: column; gap: 10px; }
  :global(.kalite-text li) { position: relative; padding-left: 22px; font-size: 14.5px; color: var(--g600); line-height: 1.7; }
  :global(.kalite-text li::before) { content: '✓'; position: absolute; left: 0; top: 0; color: var(--blue); font-weight: 700; }
  .kalite-img { border: 1px solid var(--g200); border-radius: 10px; overflow: hidden; background: #fff; padding: 10px; box-shadow: var(--sh); }
  .kalite-img img { width: 100%; height: auto; display: block; border-radius: 4px; }

  @media (max-width: 860px) {
    .kalite-layout { grid-template-columns: 1fr; }
    .kalite-img { order: -1; max-width: 280px; margin: 0 auto; }
  }
</style>
